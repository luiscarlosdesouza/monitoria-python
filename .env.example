APP_NAME="Sistema de Monitoria - IME-USP"
ENVIRONMENT=development
SECRET_KEY=change-this-in-production-super-secret-key
# Para Docker / MySQL em produção:
# DATABASE_URL=mysql+pymysql://monitoria:monitoria123@db:3306/monitoria_db?charset=utf8mb4
# Para desenvolvimento local:
DATABASE_URL=sqlite:///./monitoria.db

# USP Senha Única OAuth 1.0a
USP_CLIENT_KEY=your_key
USP_CLIENT_SECRET=your_secret
USP_CALLBACK_ID=1

# Conexão USP Replicado (Opcional)
REPLICADO_HOST=
REPLICADO_PORT=1433
REPLICADO_DATABASE=
REPLICADO_USERNAME=
REPLICADO_PASSWORD=
